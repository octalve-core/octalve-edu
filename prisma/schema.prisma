// Octalve Edu — foundational schema (M0). Business-domain models (students,
// staff records, results, invoices, etc.) are added once PRD §5's field lists
// are finalized — deliberately not invented here (data-minimization, PRD §9).
//
// This file covers exactly M0's scope (PRD §12): Auth.js's required tables,
// Tenant/Campus (PRD §7 multi-campus), and TenantMembership — the verified
// membership table the tenant-trust-boundary check (PRD §7) queries before
// any `SET LOCAL app.tenant_id` is ever run.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js (NextAuth v5) required models, database session strategy ---
// per PRD §7: database sessions (not JWT) so a session can be revoked by
// deleting its row — closes the security audit's session-revocation finding.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Nullable: an OAuth-only or not-yet-activated user has none (Phase 0.5 plan).
  passwordHash  String?

  accounts    Account[]
  sessions    Session[]
  memberships TenantMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Tenancy (PRD §7) ---

model Tenant {
  id        String   @id @default(cuid())
  /// URL slug (PRD §7 "Tenant code selection") — unique, reserved-word-checked
  /// and format-validated at the application layer before insert, fixed at
  /// creation for MVP (support-mediated changes only).
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  campuses    Campus[]
  memberships TenantMembership[]
}

/// A branch/campus under one tenant (PRD §7) — distinct from multi-tenancy:
/// same school, same fee structure/oversight, narrower scope inside one
/// tenant rather than a second tenant.
model Campus {
  id       String @id @default(cuid())
  tenantId String
  name     String

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]

  @@index([tenantId])
}

enum Role {
  ADMIN
  TEACHING_STAFF
  NON_TEACHING_STAFF
  STUDENT
  PARENT
}

/// The verified membership table PRD §7's tenant-trust-boundary check reads:
/// "authenticated user -> verified tenant membership -> SET LOCAL
/// app.tenant_id -> RLS". The URL's tenant code is only ever a hint; this
/// table is the actual authorization source.
model TenantMembership {
  id       String  @id @default(cuid())
  userId   String
  tenantId String
  campusId String?
  role     Role

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// --- First-run setup wizard (Solo installs only — PRD §4 onboarding row) ---

/// Singleton row (id is always "global") guarding the one-time Solo bootstrap:
/// creates the single Tenant + its first ADMIN. Never read/written in SaaS
/// mode (SaaS tenants are created via the future self-serve signup flow, not
/// this). The same atomic-conditional-update pattern used elsewhere in the
/// plan for "only one concurrent writer wins" races.
model SystemSettings {
  id            String  @id @default("global")
  setupComplete Boolean @default(false)
}

/// Brought forward from Phase 1's design (domain-implementation-plan.md
/// §1.5) because the setup wizard needs a real audit trail for who
/// bootstrapped an instance, same as every other sensitive action will.
/// Migration-level `REVOKE UPDATE, DELETE` applies here too once Phase 1's
/// migration runs (closes Audit #19/#31) — append-only from day one.
model AuditLog {
  id            String   @id @default(cuid())
  tenantId      String
  actorUserId   String
  action        String
  targetType    String
  targetId      String
  beforeValue   Json?
  afterValue    Json?
  reason        String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([tenantId, targetType, targetId])
  @@index([tenantId, createdAt])
}
