// --- People and enrolment (Phase 1.2; plan "Build design — Phase 1.2", reconciliations 1–6 and decisions P2–P8) ---
//
// Same rules as the academic tables: every row carries its own tenantId and a composite foreign key to its parents on (tenantId, id), so a row can
// never point at another school's parent; RLS and the rules Prisma cannot express (partial unique indexes, CHECKs) live in the migration SQL.
// Nothing here is deleted by a request: records are ARCHIVED. There is no national-ID, gender, religion or photo column on purpose (data minimisation).

enum StaffCategory {
  TEACHING
  NON_TEACHING
}

enum Gender {
  MALE
  FEMALE
}

enum Relationship {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

/// PENDING and REVOKED exist for later phases. In 1.2 only an administrator creates a link, and it is APPROVED; a parent can never create or approve one.
enum GuardianLinkStatus {
  PENDING
  APPROVED
  REVOKED
}

/// Only ACTIVE and WITHDRAWN are written in 1.2; the others are the year-end outcomes Phase 1.4's promotion sets.
enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATED
  WITHDRAWN
  TRANSFERRED
  ALUMNI
  /// Task 0028: the pupil was expelled; everything that selects pupils by an ACTIVE enrolment drops them without a change. Reinstating puts it back.
  EXPELLED
  /// Task 0040: the roll that placed this pupil here was undone. The row stays (a promotion record points at it and is append-only; an enrolment is unique per pupil and session), is ignored by everything
  /// that selects by ACTIVE, and is revived when the pupil is rolled or enrolled into that session again.
  CANCELLED
}

/// A member of staff as the SCHOOL knows them — not a sign-in account. userId is null for someone who never signs in (a security guard); when set it must
/// be a member of this same school (composite FK to TenantMembership) and is unique per school (partial unique index).
model StaffRecord {
  id                    String                   @id @default(cuid())
  tenantId              String
  campusId              String?
  userId                String?
  category              StaffCategory
  firstName             String
  middleName            String?
  lastName              String
  gender                Gender?
  dateOfBirth           DateTime?                @db.Date
  phone                 String?
  /// Lower-cased. Unique per school among live records when present.
  email                 String?
  address               String?
  designation           String?
  qualification         String?
  employmentDate        DateTime?                @db.Date
  nextOfKinName         String?
  nextOfKinRelationship String?
  nextOfKinPhone        String?
  nextOfKinAddress      String?
  archivedAt            DateTime?
  /// Task 0028: ACTIVE, SUSPENDED (until `standingUntil`, or until lifted when null) or TERMINATED.
  standing              StandingState @default(ACTIVE)
  standingUntil         DateTime?     @db.Date
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @default(now()) @updatedAt

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus             Campus?                  @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: NoAction)
  standingEvents     StandingEvent[]
  programPlaces      ProgramParticipant[]
  membership         TenantMembership?        @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: NoAction)
  assignments        StaffSubjectAssignment[]
  invitations        Invitation[]
  timetableSlots     TimetableSlot[]
  createdAssignments Assignment[]
  gradedSubmissions  AssignmentSubmission[]
  createdMaterials   LearningMaterial[]
  createdQuizzes     Quiz[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

/// "This teacher teaches this subject to this arm." Real DELETE (nothing references it yet; 1.3/1.4 will decide archive-on-reference like SubjectOffering).
model StaffSubjectAssignment {
  id            String   @id @default(cuid())
  tenantId      String
  staffRecordId String
  subjectId     String
  classArmId    String
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation(fields: [tenantId, staffRecordId], references: [tenantId, id], onDelete: NoAction)
  subject     Subject     @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: NoAction)
  classArm    ClassArm    @relation(fields: [tenantId, classArmId], references: [tenantId, id], onDelete: NoAction)

  @@unique([staffRecordId, subjectId, classArmId])
  @@index([tenantId])
}

/// A pupil/student. admissionNo is human-facing (typed by the school or generated `YYYY/NNNN`), unique per school ignoring case INCLUDING archived records
/// (a number is never reused) and NEVER used as a URL or lookup key by a route. userId exists for the 1.4 student sign-in; no route sets it in 1.2.
model StudentRecord {
  id          String    @id @default(cuid())
  tenantId    String
  campusId    String?
  userId      String?
  firstName   String
  middleName  String?
  lastName    String
  gender      Gender?
  dateOfBirth DateTime  @db.Date
  admissionNo String
  archivedAt  DateTime?
  /// Task 0028: ACTIVE, SUSPENDED (until `standingUntil`, or until lifted when null) or EXPELLED. A check in the migration holds the combinations.
  standing      StandingState @default(ACTIVE)
  standingUntil DateTime?     @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus              Campus?                @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: NoAction)
  membership          TenantMembership?      @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: NoAction)
  enrollments         StudentEnrollment[]
  guardians           GuardianLink[]
  attendanceRecords   AttendanceRecord[]
  results             Result[]
  invoices            Invoice[]
  guardianLinkTokens  GuardianLinkToken[]
  standingEvents      StandingEvent[]
  programPlaces       ProgramParticipant[]
  assignmentSubmissions AssignmentSubmission[]
  quizAttempts        QuizAttempt[]
  courseRegistrations CourseRegistration[]
  certificates        Certificate[]
  practiceSessions    PracticeSession[]
  practiceAttempts    PracticeAttempt[]
  questionReports     QuestionReport[]
  formResponses       FormResponse[]         @relation("StudentFormResponses")
  formTurnIns         FormTurnIn[]           @relation("StudentTurnIns")
  receivedPrintLogs   QuestionBankPrintLog[] @relation("PrintLogRecipient")

  @@unique([tenantId, id])
  @@index([tenantId])
}

/// The next admission-number sequence for a school and calendar year. Incremented with UPDATE … RETURNING in the same transaction as the student insert.
model AdmissionCounter {
  tenantId String
  year     Int
  next     Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, year])
}

/// A parent/guardian as the school knows them (usually no account yet; one guardian may be linked to several children).
model GuardianRecord {
  id         String            @id @default(cuid())
  tenantId   String
  userId     String?
  firstName  String
  middleName String?
  lastName   String
  phone      String?
  email      String?
  address    String?
  occupation String?
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership TenantMembership? @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: NoAction)
  links      GuardianLink[]
  guardianLinkTokens GuardianLinkToken[]
  programPlaces      ProgramParticipant[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model GuardianLink {
  id           String             @id @default(cuid())
  tenantId     String
  studentId    String
  guardianId   String
  relationship Relationship
  /// At most one live primary contact per student (partial unique index).
  isPrimary    Boolean            @default(false)
  status       GuardianLinkStatus @default(APPROVED)
  approvedById String?
  createdAt    DateTime           @default(now())
  revokedAt    DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  StudentRecord  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: NoAction)
  guardian GuardianRecord @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: NoAction)

  @@unique([studentId, guardianId])
  @@index([tenantId, studentId])
}

/// One row per student per SESSION (a pupil keeps one class for the year). Moving arm inside the session edits the row (audited).
model StudentEnrollment {
  id         String           @id @default(cuid())
  tenantId   String
  studentId  String
  sessionId  String
  classArmId String
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  StudentRecord   @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: NoAction)
  session  AcademicSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: NoAction)
  classArm ClassArm        @relation(fields: [tenantId, classArmId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, studentId, sessionId])
  /// Task 0031: the target of the composite foreign keys of a promotion record.
  @@unique([tenantId, id])
  @@index([tenantId, classArmId])
}
