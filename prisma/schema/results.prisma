// --- Results & Grading (Phase 1.4: Results, Approval Workflow, Publishing & Public Verification) ---
//
// Every row carries its own tenantId and composite foreign keys to parent models on (tenantId, id).
// Tenant-level RLS is enforced on all tables.
// ResultAudit is strictly append-only (REVOKE UPDATE, DELETE, TRUNCATE FROM app_user).

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  LOCKED
}

/// What an approver's scope covers (ADR 0018): GENERAL = every class of their campus (the whole school when the membership has no campus), SECTION = every class
/// group in one section, CLASS = one class group (all its arms).
enum ApprovalScopeKind {
  GENERAL
  SECTION
  CLASS
}

/// Where one person approves results (ADR 0018). Only a holder of CAN_APPROVE_RESULTS has rows; no rows means nothing to approve. Rows are added and removed, never
/// edited. The migration adds what the schema cannot say: the kind/target CHECK and the unique index on (person, kind, target).
model ResultApprovalScope {
  id           String            @id @default(cuid())
  tenantId     String
  userId       String
  kind         ApprovalScopeKind
  sectionId    String?
  classGroupId String?
  createdById  String?
  createdAt    DateTime          @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)
  section    Section?         @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: NoAction)
  classGroup ClassGroup?      @relation(fields: [tenantId, classGroupId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId, userId])
}

/// A term/period subject result for a student.
model Result {
  id                String       @id @default(cuid())
  tenantId          String
  studentId         String
  subjectId         String
  periodId          String
  score             Decimal      @db.Decimal(6, 2)
  maxScore          Decimal      @default(100) @db.Decimal(6, 2)
  status            ResultStatus @default(DRAFT)
  componentScores   Json?
  gradeLetter       String?
  gradeRemark       String?
  enteredByStaffId  String?
  approvedByStaffId String?
  publishedAt       DateTime?
  lockedAt          DateTime?
  verificationToken String?      @unique
  verificationHash  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student StudentRecord  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  subject Subject        @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Cascade)
  period  AcademicPeriod @relation(fields: [tenantId, periodId], references: [tenantId, id], onDelete: Cascade)
  history ResultAudit[]

  @@unique([tenantId, studentId, subjectId, periodId])
  @@unique([tenantId, id])
  @@index([tenantId, periodId])
  @@index([tenantId, studentId, periodId])
  @@index([tenantId, subjectId, periodId])
  @@index([verificationToken])
}

/// Append-only audit record tracking every state transition and post-lock score adjustment.
model ResultAudit {
  id          String       @id @default(cuid())
  tenantId    String
  resultId    String
  actorUserId String
  fromStatus  ResultStatus
  toStatus    ResultStatus
  fromScore   Decimal?     @db.Decimal(6, 2)
  toScore     Decimal?     @db.Decimal(6, 2)
  reason      String?
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  result Result @relation(fields: [tenantId, resultId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, resultId])
  @@index([tenantId, createdAt])
}

/// The teacher's and the principal's remark on a pupil's report card for one term (task 0036). One row per pupil and term; a row with both remarks cleared is deleted (a check says one is
/// present). Each remark is 1 to 500 characters and records who wrote it. Like the promotion tables it carries no Prisma relations: the links are composite foreign keys on (tenantId, id) in
/// the migration, so a remark can never point at another school's pupil or term. Editable until any of the pupil's results for the term is published (a service rule).
model ReportRemark {
  id                      String   @id @default(cuid())
  tenantId                String
  studentId               String
  periodId                String
  teacherRemark           String?
  teacherRemarkByUserId   String?
  principalRemark         String?
  principalRemarkByUserId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  @@unique([tenantId, studentId, periodId])
  @@index([tenantId, periodId])
}
