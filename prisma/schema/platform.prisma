// --- The platform surface (plan C5, ADR 0016) ---

/// What the platform did to a school (created, suspended, type changed). No `tenantId` column ON PURPOSE: it is not a school's data, it must
/// outlive a school, and no school's administrator may read it. Row-level security is on with NO policy for the runtime role, so `app_user`
/// can neither read nor write it; only the `platform_*` SECURITY DEFINER functions (run as the table owner) do. Append-only by construction.
model PlatformAuditLog {
  id             String   @id @default(cuid())
  actorUserId    String
  action         String
  /// The school acted on. Plain text, not a foreign key: the history must survive the school.
  targetTenantId String?
  beforeValue    Json?
  afterValue     Json?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

/// Four coarse counters per school for the platform page (task 0010 F1, ADR 0016). Kept by triggers on TenantMembership, StudentRecord and Campus
/// (migration 20261023090000); row-level security forces a policy for the OWNER only, so the runtime role reads and writes nothing here - the
/// numbers leave the database only through `platform_school_stats()`. Not used by application code directly.
model TenantStats {
  tenantId      String   @id
  activeMembers Int      @default(0)
  activeAdmins  Int      @default(0)
  students      Int      @default(0)
  campuses      Int      @default(0)
  updatedAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// A school's grant of read-only support access to a platform administrator (task 0011, ADR 0017). A row in the SCHOOL's own data (row-level
/// security); the database limits it to the grantable areas and 24 hours and lets it only be revoked, never edited or deleted. `granteeUserId` null
/// = any platform administrator. The platform sees live grants only through `platform_support_grants()`.
model SupportGrant {
  id            String    @id @default(cuid())
  tenantId      String
  granteeUserId String?
  areas         String[]
  reason        String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grantee   User?  @relation("SupportGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("SupportGrantCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}
