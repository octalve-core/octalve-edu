// --- School settings (plan §1.3, built in Phase 1.0 as the row and its defaults only; no write path or screen until roadmap 1.7) ---

enum BillingCycle {
  PER_TERM
  PER_SESSION
}

enum RolloverMode {
  AUTOMATIC
  ADMIN_CONFIRMED
}

enum DiscountWorkflowMode {
  MANUAL_OVERRIDE
  APPROVAL_REQUIRED
}

enum FeeCostBearer {
  SCHOOL_ABSORBS
  PASSED_TO_PARENT
}

/// Whether an approver with a Section scope may also act on the class groups that have no section (ADR 0018, amendment of 2026-10-23). The default is the fail-closed
/// one: such a class group is reached only through a General scope or a Class scope on it.
enum UnsectionedClassApproval {
  GENERAL_OR_CLASS_ONLY
  ANY_SECTION_APPROVER
}

/// One row per school, BY CONSTRUCTION: the tenant id is the primary key. The row is inserted by a trigger on "Tenant", so no
/// creation path can forget it, and the defaults below are the secure ones (results need approval; teaching staff need MFA).
model SchoolSettings {
  tenantId String @id

  resultApprovalRequired Boolean              @default(true)
  rolloverMode           RolloverMode         @default(ADMIN_CONFIRMED)
  classAutoAssignment    Boolean              @default(false)
  billingCycle           BillingCycle         @default(PER_TERM)
  feeReminderEnabled     Boolean              @default(true)
  discountWorkflowMode   DiscountWorkflowMode @default(MANUAL_OVERRIDE)
  feeCostBearer          FeeCostBearer        @default(SCHOOL_ABSORBS)
  multiCampusEnabled     Boolean              @default(false)
  mfaRequiredForTeaching Boolean              @default(true)
  /// ADR 0018: who may approve the results of a class group that has no section.
  unsectionedClassApproval UnsectionedClassApproval @default(GENERAL_OR_CLASS_ONLY)
  /// The school's own time zone (an IANA name): where its day starts, for the limits counted in days (the practice cap, the reports one person may make). "UTC" until the
  /// administrator chooses; the application checks the name, the database only its length. See src/lib/school-settings/school-day.ts.
  timeZone String @default("UTC")

  updatedAt DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Immutable append-only audit log for SchoolSettings changes (PRD §14, plan §1.3).
/// Every change requires stepUpVerifiedAt (re-authentication timestamp: fresh TOTP or password proof).
model SettingsChangeAudit {
  id               String   @id @default(cuid())
  tenantId         String
  actorUserId      String
  field            String
  fromValue        String
  toValue          String
  stepUpVerifiedAt DateTime
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}
